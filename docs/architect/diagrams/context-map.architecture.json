  "cards": [
    {
      "dot": "cyan",
      "title": "Upstream",
      "items": [
        "Backend callers decide when and whom to notify",
        "No caller is committed yet; DKNet.Accounts.Api is likely first",
        "The service never subscribes to callers' events",
        ".NET callers may reference DKNet.Notification.Client; others call HTTPS directly",
        "The client attaches no credential: the caller's own DelegatingHandler adds the token"
      ]
    },
    {
      "dot": "emerald",
      "title": "Downstream",
      "items": [
        "Email goes to the SMTP provider or Microsoft Graph: one sender per deployment",
        "Teams Workflows receives finished Teams cards",
        "Graph needs a mail-sender app with Mail.Send scoped to one mailbox",
        "One set of channel settings per deployment"
      ]
    },
    {
      "dot": "violet",
      "title": "Build-time only",
      "items": [
        "DKNet.Templates: one-time scaffold, no runtime link",
        "DKNet packages: DKNet.Svc.Transformation, DKNet.AspCore.Idempotency (+ RedisStore), DKNet.AspCore.Extensions",
        "DKNet.Notification.Client: released with the service to GitHub Packages; it depends only on Refit and .NET HTTP libraries",
        "Callers point to the client, the client to the service; the service points back to no caller: no cycle"
      ]
    }
  ]

{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Send an Email Notification through Microsoft Graph",
    "output": "send-email-graph.html",
    "viewBox": [
      1080,
      640
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "caller",
      "type": "external",
      "label": "Backend caller",
      "sublabel": "client credentials"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "Notification API",
      "sublabel": "POST /v1/notifications"
    },
    {
      "id": "queue",
      "type": "messagebus",
      "label": "Delivery queue",
      "sublabel": "in process, 1,000"
    },
    {
      "id": "worker",
      "type": "backend",
      "label": "Delivery worker",
      "sublabel": "Sender = Graph"
    },
    {
      "id": "entra",
      "type": "security",
      "label": "Entra ID",
      "sublabel": "token endpoint"
    },
    {
      "id": "graph",
      "type": "cloud",
      "label": "Microsoft Graph",
      "sublabel": "sendMail, 1 mailbox"
    }
  ],
  "segments": [
    {
      "from": 160,
      "to": 262,
      "label": "Accept"
    },
    {
      "from": 272,
      "to": 372,
      "label": "Take and sign in"
    },
    {
      "from": 382,
      "to": 500,
      "label": "Deliver"
    }
  ],
  "messages": [
    {
      "id": "post",
      "from": "caller",
      "to": "api",
      "y": 172,
      "label": "POST channel=email + Idempotency-Key",
      "variant": "emphasis",
      "note": "Flow 1 steps 1 to 6: token, key, checks, render"
    },
    {
      "id": "enqueue",
      "from": "api",
      "to": "queue",
      "y": 210,
      "label": "rendered message",
      "variant": "emphasis"
    },
    {
      "id": "accepted",
      "from": "api",
      "to": "caller",
      "y": 246,
      "label": "202 notificationId",
      "variant": "return"
    },
    {
      "id": "take",
      "from": "queue",
      "to": "worker",
      "y": 288,
      "label": "next notification",
      "variant": "default"
    },
    {
      "id": "token",
      "from": "worker",
      "to": "entra",
      "y": 322,
      "label": "token for graph.microsoft.com/.default",
      "variant": "security",
      "note": "skipped while the held token is valid"
    },
    {
      "id": "token-ok",
      "from": "entra",
      "to": "worker",
      "y": 354,
      "label": "access token (mail-sender app)",
      "variant": "return"
    },
    {
      "id": "send",
      "from": "worker",
      "to": "graph",
      "y": 394,
      "label": "POST /users/{Mailbox}/sendMail, attempt 1",
      "variant": "emphasis"
    },
    {
      "id": "throttled",
      "from": "graph",
      "to": "worker",
      "y": 424,
      "label": "429 Retry-After: wait, at most 60 s",
      "variant": "return"
    },
    {
      "id": "retry",
      "from": "worker",
      "to": "graph",
      "y": 458,
      "label": "sendMail, attempt 2",
      "variant": "dashed"
    },
    {
      "id": "ok",
      "from": "graph",
      "to": "worker",
      "y": 488,
      "label": "202 Accepted: Delivered",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "api",
      "from": 172,
      "to": 250,
      "type": "backend"
    },
    {
      "participant": "worker",
      "from": 284,
      "to": 494,
      "type": "backend"
    },
    {
      "participant": "entra",
      "from": 318,
      "to": 358,
      "type": "security"
    },
    {
      "participant": "graph",
      "from": 390,
      "to": 492,
      "type": "cloud"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Same acceptance as SMTP",
      "items": [
        "Callers send the same request and get the same 202",
        "Graph selected with a setting missing: start-up warning, email ends Skipped",
        "202 means accepted, never delivered"
      ]
    },
    {
      "dot": "rose",
      "title": "Sign-in and scope",
      "items": [
        "The worker signs in as the mail-sender app: workload identity, or a client secret off Kubernetes",
        "Mail.Send is scoped to the one sending mailbox",
        "A 403 means the mailbox is out of scope: Failed at once"
      ]
    },
    {
      "dot": "amber",
      "title": "Retry rule",
      "items": [
        "Transient, for the token request and sendMail: 408, 429, 5xx, timeouts; at most 3 attempts",
        "A 429 waits for Retry-After, at most 60 s",
        "Permanent: any other 4xx, such as a token invalid_client or a 403",
        "No library retries inside an attempt: Azure.Identity retry is off"
      ]
    }
  ]
}

  "cards": [
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Service edge: every call except /healthz needs an Entra ID token with notifications.send (scp, scope or roles)",
        "Callers name a Teams destination, never a URL",
        "Out: SMTP with TLS and credentials; HTTPS to webhook URLs from settings only"
      ]
    },
    {
      "dot": "cyan",
      "title": "Accept, then deliver",
      "items": [
        "The API validates and renders inside the call, then answers 202",
        "Unsupported or unconfigured channel: 202, warning log, nothing sent",
        "Full queue: 503 with Retry-After 30"
      ]
    },
    {
      "dot": "amber",
      "title": "Best effort",
      "items": [
        "Retries: 5 s then 30 s, at most 3 attempts",
        "A process stop loses queued notifications",
        "No database; notifications live in memory only"
      ]
    },
    {
      "dot": "violet",
      "title": "Settings and secrets",
      "items": [
        "One set of channel settings per deployment",
        "SMTP password and webhook URLs: environment variables or Azure App Configuration",
        "Local run: Aspire AppHost with Redis and Mailpit"
      ]
    }
  ]
}
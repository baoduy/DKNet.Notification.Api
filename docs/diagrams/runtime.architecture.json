  "cards": [
    {
      "dot": "rose",
      "title": "Service edge",
      "items": [
        "Pipeline: forwarded + security headers, CORS, HTTPS, routing, request bounds, rate limiter, then JWT sign-in",
        "Every route except /healthz needs a token; notifications.send needs a caller claim plus the scope or role",
        "RequireAuthorization off (Development, Testing): no sign-in middleware runs",
        "/healthz: anonymous liveness, no Redis check"
      ]
    },
    {
      "dot": "cyan",
      "title": "Accept, then deliver",
      "items": [
        "POST renders from the in-image templates, counts the Redis list, writes pending, publishes, answers 200",
        "List at QueueCapacity (Notifications:Delivery:QueueCapacity, 1–100,000, whole service): 503 QUEUE_FULL, Retry-After 30",
        "Skipped call (channel off, unknown destination): 200, status failed, nothing queued",
        "GET reads the caller's own status for RetentionHours (default 24)"
      ]
    },
    {
      "dot": "amber",
      "title": "Retries",
      "items": [
        "One attempt per message; 5 s then 30 s, at most 3 attempts; a 429 waits for Retry-After, at most 60 s",
        "A retry or not-due message goes back to the Redis list with a not-before time",
        "Status writes are best effort: a failure logs and never fails the call"
      ]
    },
    {
      "dot": "emerald",
      "title": "Without Redis (Development, Testing only)",
      "items": [
        "Idempotency, cache, status and the delivery bus fall back to memory",
        "The in-process backlog always counts 0, so QUEUE_FULL never fires",
        "Any other environment without ConnectionStrings:Redis fails at start-up"
      ]
    },
    {
      "dot": "violet",
      "title": "Settings and local run",
      "items": [
        "Sender = Smtp (default) or Graph; Graph signs in with workload identity or a client secret",
        "Azure App Configuration and OpenTelemetry are optional, off by default",
        "Aspire AppHost: Redis and Mailpit (SMTP 1025, STARTTLS)"
      ]
    }
  ]

  "cards": [
    {
      "dot": "cyan",
      "title": "Acceptance and delivery",
      "items": [
        "New accepted call: render and write pending before publishing; skipped call writes failed without publishing",
        "A returned id means accepted, including skipped calls; it does not certify delivery",
        "Queued: pending until provider acceptance or terminal failure; skipped: failed immediately",
        "Cached acceptance replays its id without queueing again; status is read separately"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure and retry",
      "items": [
        "Service refusal or unreadable success body: NotificationApiException with HTTP status and errors",
        "QUEUE_FULL: wait 30 seconds, then retry the same key; transport errors reach the caller unchanged",
        "The package adds no retry policy; caller handlers can retry"
      ]
    }
  ]

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "AzureMonitor": {
    "ConnectionString": ""
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowedMethods": ["GET", "POST", "PUT", "PATCH"],
    "AllowedHeaders": ["Authorization", "Content-Type", "Accept", "Idempotency-Key"]
  },
  "Security": {
    "TrustedProxies": [],
    "TrustedNetworks": []
  },
  "Https": {
    "HstsMaxAgeDays": 365
  },
  "RequestBounds": {
    "RequestTimeoutSeconds": 30,
    "MaxRequestBodySizeBytes": 1048576,
    "RequestHeadersTimeoutSeconds": 10
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "OTEL_SERVICE_NAME": "DKNet.Notification.Api",
  "Authentication": {
    "DefaultScheme": "Bearer",
    "Schemes": {
      "Bearer": {
        "MetadataAddress": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0/.well-known/openid-configuration",
        "ValidAudiences": [
          "api://your-api"
        ],
        "ValidIssuer": "https://sts.windows.net/00000000-0000-0000-0000-000000000000/"
      }
    }
  },
  "FeatureManagement": {
    "EnableHttps": true,
    "EnableSwagger": false,
    "EnableAntiforgery": false,
    "RequireAuthorization": true,
    "EnableRateLimit": true,
    "EnableAzureAppConfig": false,
    "EnableVersioning": true,
    "EnableOpenTelemetry": false,
    "EnableSecurityHeaders": true,
    "EnableForwardedHeaders": true,
    "EnableRequestBounds": true
  },
  "RateLimit": {
    "DefaultRequestLimit": 100,
    "DefaultConcurrentLimit": 20,
    "TimeWindowInSeconds": 1
  },
  "ConnectionStrings": {
    "AzureAppConfig": ""
  },
  "AzureAppConfiguration": {
    "KeyPrefix": "",
    "Label": "",
    "CacheExpirationInSeconds": 300,
    "LoadFeatureFlags": true,
    "FeatureFlagPrefix": ""
  },
  "Notifications": {
    "Templates": [
      {
        "TemplateId": "account-opened",
        "Description": "Sent when an account is opened.",
        "Versions": [
          {
            "Channel": "email",
            "File": "account-opened.email.html",
            "Format": "Html",
            "Subject": "Your account is open"
          }
        ]
      }
    ]
  }
}
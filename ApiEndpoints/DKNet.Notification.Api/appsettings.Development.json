{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "None",
      "Microsoft.Hosting.Lifetime": "None"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "ApplicationInsights": {
    "InstrumentationKey": ""
  },
  "RateLimit": {
    "DefaultRequestLimit": 1,
    "DefaultConcurrentLimit": 1,
    "TimeWindowInSeconds": 10
  },
  "FeatureManagement": {
    "EnableHttps": false,
    "EnableSwagger": true,
    "EnableAntiforgery": false,
    "RequireAuthorization": false,
    "EnableRateLimit": false,
    "EnableAzureAppConfig": false,
    "EnableSecurityHeaders": true,
    "EnableForwardedHeaders": true,
    "EnableRequestBounds": true
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "http://localhost:5000"
        ],
        "ValidIssuer": "dotnet-user-jwts"
      }
    }
  },
  "Notifications": {
    "Email": {
      "Enabled": true,
      "Sender": "Smtp",
      "Smtp": {
        "Security": "StartTls",
        "FromAddress": "notifications@localhost.dev"
      }
    }
  }
}
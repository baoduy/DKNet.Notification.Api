<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <ContainerRepository>baoduy/dknet.notification-api</ContainerRepository>
        <ContainerImageTags>1.0.0;latest</ContainerImageTags>
        <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-alpine</ContainerBaseImage>
        <!-- The base image's own non-root user (uid 1654). Named literally, not as $APP_UID: that is the
             image's environment variable, not an MSBuild property, so it reaches the image as the literal
             string "$APP_UID" and docker fails with "unable to find user $APP_UID". -->
        <ContainerUser>app</ContainerUser>
      <UserSecretsId>F5FED893-2457-4AAF-BB5A-0FB28856581D</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Asp.Versioning.Http" />
        <PackageReference Include="Azure.Identity" />
        <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
        <PackageReference Include="DKNet.AspCore.Extensions" />
        <PackageReference Include="DKNet.AspCore.Idempotency" />
        <PackageReference Include="DKNet.AspCore.Idempotency.RedisStore" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.Azure.AppConfiguration.AspNetCore" />
        <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
        <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
        <PackageReference Include="OpenTelemetry" />
        <PackageReference Include="OwaspHeaders.Core" />
        <PackageReference Include="OpenTelemetry.Exporter.Console" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="Scalar.AspNetCore" />
        <PackageReference Include="SharpGrip.FluentValidation.AutoValidation.Endpoints" />
        <PackageReference Include="SlimMessageBus.Host.Memory" />
        <PackageReference Include="SlimMessageBus.Host.Redis" />
        <PackageReference Include="SlimMessageBus.Host.Serialization.SystemTextJson" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\DKNet.Notification.AppServices\DKNet.Notification.AppServices.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Template files are read at start-up from <content root>/Templates, in the build and publish output. -->
        <None Update="Templates/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DKNet.Notification.App.Tests" />
        <InternalsVisibleTo Include="DKNet.Notification.App.TestSupport" />
        <InternalsVisibleTo Include="DKNet.Templates.ScaffoldTests" />
    </ItemGroup>
</Project>

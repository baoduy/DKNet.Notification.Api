<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>default</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Both already ship with the Api (FluentValidation through its DependencyInjectionExtensions, logging
             through the ASP.NET Core shared framework); referenced here for the validators and log entries. -->
        <!-- Template rendering (ADR-0004). -->
        <PackageReference Include="DKNet.Svc.Transformation" />
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DKNet.Notification.Domains\DKNet.Notification.Domains.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DKNet.Notification.App.Tests"/>
    </ItemGroup>

</Project>

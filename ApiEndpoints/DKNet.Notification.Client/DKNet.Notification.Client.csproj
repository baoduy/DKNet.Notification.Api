<Project Sdk="Microsoft.NET.Sdk">

    <!-- Typed Refit client for this solution's API, published as its own NuGet package for downstream
         systems. It carries its own contracts and references no project of the solution. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <Description>Typed Refit client for the DKNet.Notification API.</Description>
        <!-- Override the icon inherited from Directory.Packages.props — no icon file ships with this package. -->
        <PackageIcon></PackageIcon>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Refit"/>
        <PackageReference Include="Refit.HttpClientFactory"/>
        <PackageReference Include="Microsoft.Extensions.Http"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    </ItemGroup>

</Project>

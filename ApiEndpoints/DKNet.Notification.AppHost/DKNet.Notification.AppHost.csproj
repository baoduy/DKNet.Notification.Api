<Project Sdk="Aspire.AppHost.Sdk/13.6.0">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAspireHost>true</IsAspireHost>
        <UserSecretsId>29094C1F-9FD8-4C6B-800B-3920D0CBF127</UserSecretsId>
        <!-- Disable code analysis for test entities -->
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <AnalysisMode>None</AnalysisMode>
        <RunAnalyzers>false</RunAnalyzers>
        <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
        <RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- ASPIRE010: dashboard/DCP deprecation warning, understood and deliberately deferred —
             AspireUseCliBundle requires the Aspire CLI on PATH, which breaks a bare `dotnet build`
             on a clean scaffolded machine. NoWarn keeps the template buildable everywhere.
             ASPIRECERTIFICATES001: the developer-certificate API Mailpit's STARTTLS uses (DRK-2020 Local run) is
             marked for evaluation; it is the local run's only way to a certificate the machine already trusts. -->
        <NoWarn>$(NoWarn);CS1591;SA1600;ASPIRE010;ASPIRECERTIFICATES001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.Redis" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DKNet.Notification.Api\DKNet.Notification.Api.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="Aspire.Hosting">
        <HintPath>bin\Debug\net10.0\Aspire.Hosting.dll</HintPath>
      </Reference>
    </ItemGroup>

</Project>
